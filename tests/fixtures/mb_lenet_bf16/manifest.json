   "op_class": "conv",
   "entry": "kernel_conv2d_bf16",
   "signature": "void kernel_conv2d_bf16(const __nv_bfloat16 *input, const __nv_bfloat16 *weight, const __nv_bfloat16 *bias, __nv_bfloat16 *output, int N, int IC, int IH, int IW, int OC, int KH, int KW, int SH, int SW, int PH, int PW, int DH, int DW)",
   "file": "slots/conv2d_bf16.cu",
   "reference_file": "slots/conv2d_bf16.ref.c",
   "semantics": "(bf16) 2D convolution matching torch.nn.Conv2d semantics with groups=1 and dilation (DH, DW).\nLayout (row-major, NCHW for activations / OIHW for weights):\n  input:  [N, IC, IH, IW]\n  weight: [OC, IC, KH, KW]\n  bias:   [OC] (may be NULL \u2014 treat as zeros)\n  output: [N, OC, OH, OW]  with\n    OH = (IH + 2*PH - DH*(KH-1) - 1) / SH + 1\n    OW = (IW + 2*PW - DW*(KW-1) - 1) / SW + 1\nDefinition (zero-padding implied by PH, PW):\n  output[n, oc, oh, ow] = bias[oc] + sum over ic, kh, kw of\n    input[n, ic, oh*SH - PH + kh*DH, ow*SW - PW + kw*DW]\n    * weight[oc, ic, kh, kw]\n  with input reads outside [0, IH) x [0, IW) treated as 0.\nAll tensors are float32.",
   "seed_source": "hand",
